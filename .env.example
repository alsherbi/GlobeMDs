# GlobeMDs mobile — environment
# Copy to .env for local development (`npx expo start` reads EXPO_PUBLIC_* vars).
# For EAS builds, set the same values per profile:
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value ...
#
# ⚠️ These MUST point at the SAME Supabase project as the GlobeMDs.com web app.
# The anon key is safe to ship in the client (RLS is the security boundary);
# NEVER put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://ophgnlxuusrupquxinpd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Optional: staging project for the "preview" build profile
# EXPO_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
