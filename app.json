{
  "expo": {
    "name": "GlobeMDs",
    "slug": "globemds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "globemds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.globemds.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:globemds.com", "applinks:www.globemds.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "GlobeMDs uses the camera to let you take a profile photo or attach an image to a post.",
        "NSPhotoLibraryUsageDescription": "GlobeMDs accesses your photo library so you can choose a profile photo or attach images to posts and messages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.globemds.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B4F6C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "globemds.com", "pathPrefix": "/" },
            { "scheme": "https", "host": "www.globemds.com", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4F6C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B4F6C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GlobeMDs accesses your photos so you can choose a profile photo or attach images to posts and messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
